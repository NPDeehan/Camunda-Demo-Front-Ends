# Camunda 8 SaaS connection
CAMUNDA_BASE_URL=https://<region>.api.camunda.io/<cluster-id>/v2
CAMUNDA_OAUTH_URL=https://login.cloud.camunda.io/oauth/token
CAMUNDA_CLIENT_ID=your-client-id
CAMUNDA_CLIENT_SECRET=your-client-secret
CAMUNDA_TOKEN_AUDIENCE=zeebe.camunda.io

# Docker Compose only: which address to publish the ports on. Default is this machine only.
# The proxy has no authentication — only widen this on a network you trust.
# BIND_ADDRESS=0.0.0.0

# Optional: separate cluster for the read-only monitoring dashboard
# (allied-henna-cluster-explorer). Falls back to the cluster above when unset.
# OAUTH_URL / TOKEN_AUDIENCE default to the values above.
MONITOR_CAMUNDA_BASE_URL=
MONITOR_CAMUNDA_CLIENT_ID=
MONITOR_CAMUNDA_CLIENT_SECRET=
# MONITOR_CAMUNDA_OAUTH_URL=
# MONITOR_CAMUNDA_TOKEN_AUDIENCE=
